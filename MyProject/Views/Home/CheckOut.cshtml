@section Scripts {
	<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
	<script>
		const createHiddenInput = (form, name, value) => {
			const hiddenField = document.createElement('input');
			hiddenField.type = 'hidden';
			hiddenField.name = name;
			hiddenField.value = value;
			form.appendChild(hiddenField);
		};
		const handleGetStore = () => {
			const form = document.createElement("form");
			form.method = "POST";
			form.action = "https://logistics-stage.ecpay.com.tw/Express/map"; // 這是測試的網址，文件上會寫正式的是哪個網址
			createHiddenInput(form, "MerchantID", "2000132");
			createHiddenInput(form, "LogisticsType", "CVS");
			createHiddenInput(form, "LogisticsSubType", "UNIMART");
			createHiddenInput(form, "IsCollection", "Y");
			createHiddenInput(form, "ServerReplyURL", "https://localhost:7063/home/checkout");
			document.body.appendChild(form);
			form.submit();
		}
		document.getElementById("selectStore").addEventListener("click", handleGetStore);





		document.getElementById("confirmPaymentBtn").addEventListener("click", confirmPayment);
		function confirmPayment() {
			var selectPayment = document.getElementById("selectPayment").value;
			
			// 驗證表單欄位
			const name = document.getElementById("name").value;
			const address = document.getElementById("address").value;
			const email = document.getElementById("email").value;
			const phone = document.getElementById("phone").value;

			if (!name || !address || !email || !phone) {
				Swal.fire({
					title: '請填寫完整資訊',
					text: '請確認所有必填欄位都已填寫',
					icon: 'warning',
					confirmButtonText: '確定'
				});
				return;
			}

			// 獲取前端資訊
			const formData = {
				Name: name,
				Address: address,
				Address2: document.getElementById("address2").value,
				Email: email,
				Phone: phone,
				Payment: selectPayment,
				TotalAmount: parseFloat(document.getElementById("totalAmount").innerText)
			};

			// 顯示載入中
			Swal.fire({
				title: '處理中...',
				text: '請稍候',
				allowOutsideClick: false,
				didOpen: () => {
					Swal.showLoading();
				}
			});

			// 使用 Fetch API 將資料發送到後端
			const url = '@Url.Action("ConfirmPayment", "Home")';
			fetch(url, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(formData)
			})
			.then(response => {
				if (!response.ok) {
					throw new Error('Network response was not ok');
				}
				return response.json();
			})
			.then(data => {
				console.log('後端回應：', data);
				
				if (data.success) {
					if (data.paymentUrl) {
						// LINE Pay 付款，導向到 LINE Pay 頁面
						Swal.fire({
							title: '導向付款頁面',
							text: '即將前往 LINE Pay 付款...',
							icon: 'info',
							showConfirmButton: false,
							timer: 1500
						}).then(() => {
							window.location.href = data.paymentUrl;
						});
					} else {
						// 取貨付款，直接完成
						Swal.fire({
							title: '訂單建立成功！',
							text: '訂單編號：' + data.orderId,
							icon: 'success',
							confirmButtonText: '確定'
						}).then(() => {
							window.location.href = '@Url.Action("PaymentResult", "Home")?success=true&orderId=' + data.orderId;
						});
					}
				} else {
					Swal.fire({
						title: '訂單建立失敗',
						text: data.message || '發生未知錯誤',
						icon: 'error',
						confirmButtonText: '確定'
					});
				}
			})
			.catch(error => {
				console.error('發生錯誤：', error);
				Swal.fire({
					title: '發生錯誤',
					text: '請稍後再試或聯繫客服',
					icon: 'error',
					confirmButtonText: '確定'
				});
			});
		}
	</script>
}




